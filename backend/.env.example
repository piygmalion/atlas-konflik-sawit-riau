# Salin ke backend/.env (jangan commit .env)

# Wajib untuk sync & API write
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsional: kunci untuk POST /api/v1/sync dari luar
SYNC_API_KEY=change-me-long-random

# Path data serving (default: ../data relatif ke backend/)
DATA_DIR=

# Host/port API lokal
API_HOST=127.0.0.1
API_PORT=8787

# CORS — origin frontend (pisahkan koma)
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://piygmalion.github.io
